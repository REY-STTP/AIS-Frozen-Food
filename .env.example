# WAJIB — URL publik kanonik (tanpa trailing slash, harus https + www konsisten)
# Dipakai untuk metadataBase, canonical, OG image, sitemap, robots, JSON-LD, dan proxy 308 redirect.
# Proxy akan redirect host non-kanonik ke host ini (www vs non-www). Jika kosong, fallback ke https://www.ais-frozen-food.vercel.app
# Contoh: https://www.domain-anda.com
NEXT_PUBLIC_SITE_URL=https://www.ais-frozen-food.vercel.app

# OPSIONAL — WhatsApp Business Catalog sync (Phase 3 task 31, lib/catalog.ts)
# Isi jika mau sync katalog ke Meta Graph API: https://graph.facebook.com/v20.0/{CATALOG_ID}/products
# WHATSAPP_TOKEN=EAAGxxxxxxxxxxxxxxxx
# WHATSAPP_CATALOG_ID=1234567890

# OPSIONAL — Sentry error tracking free tier (Phase 5 task 50, instrumentation.ts)
# Aktifkan dengan: npm i @sentry/nextjs lalu uncomment SENTRY_DSN
# SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# OPSIONAL — Plausible analytics (Phase 4 task 33, app/layout.tsx)
# Default pakai hostname dari NEXT_PUBLIC_SITE_URL. Isi hanya jika beda domain.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=www.ais-frozen-food.web.id
